 doi = {10.2514/1.G005925},
 title = {Ring Formation Maneuver: Double-Integrator Kinematics with Input Saturation},
 url = {https://www.semanticscholar.org/paper/27b1fd55c433623997efe66ec3b3bf882e080c1f},
