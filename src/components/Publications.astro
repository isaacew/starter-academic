---
import { site } from '@data/site';

interface Publication {
  title: string;
  year: number;
  authors: string;
  publication: string;
  doi?: string;
  type: string;
  abstract: string;
  url?: string;
}

interface Props {
  publications: Publication[];
  limit?: number;
}

const { publications, limit } = Astro.props;
const displayedPubs = limit ? publications.slice(0, limit) : publications;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const publicationsHref = `${base}publications`;
---

<section
  id="publications"
  class="mb-24 scroll-mt-24 lg:mb-32 lg:scroll-mt-8"
  aria-labelledby="publications-heading"
>
  <h2 id="publications-heading" class="section-heading">Publications</h2>
  <div class="reveal-content mt-8">
    <div class="space-y-8">
      {displayedPubs.map((pub) => (
        <article class="space-y-3 border-b border-slate-subtle pb-8 last:border-0 last:pb-0">
          <div class="space-y-1">
            <h3 class="text-base font-semibold text-white-soft lg:text-lg">
              {pub.url ? (
                <a href={pub.url} target="_blank" rel="noreferrer" class="subtle-link hover:text-accent">
                  {pub.title}
                </a>
              ) : (
                pub.title
              )}
            </h3>
            <p class="text-sm text-slate-light">
              <span class="font-medium">{pub.authors}</span>
            </p>
            <p class="text-xs text-slate-lighter">
              {pub.publication}
              {pub.year && <span class="ml-2">({pub.year})</span>}
              {pub.type && <span class="ml-2 rounded-full bg-slate-subtle px-2 py-0.5 text-xs">{pub.type}</span>}
            </p>
          </div>
          {pub.abstract && (
            <p class="text-sm leading-relaxed text-slate-lighter">{pub.abstract}</p>
          )}
          <div class="flex flex-wrap gap-3 pt-2">
            {pub.doi && (
              <a
                href={`https://doi.org/${pub.doi}`}
                target="_blank"
                rel="noreferrer"
                class="text-xs font-medium text-accent transition hover:text-slate-light"
              >
                DOI: {pub.doi}
              </a>
            )}
            {pub.url && (
              <a
                href={pub.url}
                target="_blank"
                rel="noreferrer"
                class="text-xs font-medium text-accent transition hover:text-slate-light"
              >
                View Paper
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
    {limit && publications.length > limit && (
      <div class="mt-10 text-center">
        <a
          href={publicationsHref}
          class="inline-flex items-center gap-2 rounded-full border border-slate-subtle bg-slate-subtle/25 px-6 py-3 text-sm font-semibold text-white-soft transition hover:bg-slate-subtle/40 hover:text-accent hover:-translate-y-0.5"
        >
          View all {publications.length} publications
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

